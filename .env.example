# Anthropic API key for the slot extractor LLM call.
# Get yours at https://console.anthropic.com/settings/keys
#
# Without this, the agent falls back to deterministic regex-only extraction
# per DECISIONS #18. Most natural-language inputs land as AMBIGUOUS and the
# orchestrator re-prompts. Structured inputs (account IDs, yes/no) still work.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: gate live-smoke API tests against the prodigaltech.com stub.
# Not used by the CLI or eval suite. See PLAN §4 / DECISIONS #26.
# PAYMENT_AGENT_LIVE_SMOKE=1
